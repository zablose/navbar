{
    "name": "zablose/navbar",
    "description": "Navbar - Build an HTML from the navigation entities, stored in a database.",
    "keywords": [
        "navbar",
        "navigation",
        "html",
        "builder"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergejs Zablockis",
            "email": "zablose@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*"
    },
    "require-dev": {
        "ext-pdo": "*",
        "fakerphp/faker": "^1.24.1",
        "laravel/framework": "^12.20.0",
        "laravel/tinker": "^2.10.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.2",
        "phpunit/phpunit": "^12.2.7"
    },
    "autoload": {
        "psr-4": {
            "Zablose\\Navbar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "laravel/app/",
            "Zablose\\Navbar\\Tests\\": "laravel/tests/"
        },
        "classmap": [
            "laravel/database/seeders"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
